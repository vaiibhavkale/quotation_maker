# - Database (Supabase → Project Settings → Database → Connection string) -
# Note: the pooler cluster prefix isn't always "aws-0" — some projects are on
# "aws-1". If a connection fails with "Tenant or user not found", try the other.
#
# DATABASE_URL (app runtime, transaction pooler, port 6543) MUST connect as
# `hiqm_app`, NOT `postgres`. Supabase's `postgres` role has BYPASSRLS, which
# makes every RLS policy in this project a silent no-op — the multi-tenant
# isolation guarantee only holds if the app cannot bypass it. Run
# `npm run db:migrate` first (creates the `hiqm_app` role), then:
#   ALTER ROLE hiqm_app WITH PASSWORD '<generate a strong one>';
DATABASE_URL="postgresql://hiqm_app.[ref]:[hiqm_app password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# DIRECT_DATABASE_URL (migrations/seed only, session pooler, port 5432) stays
# on `postgres` — seeding needs to write freely without RLS getting in the way.
DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[postgres password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# - Auth (generate with: openssl rand -base64 32) -
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# - App -
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# - AI (Groq Cloud — console.groq.com) -
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
