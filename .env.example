# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Use the "Transaction" pooler URL (port 6543) for the app on Vercel,
# and the "Session" URL (port 5432) for migrations/seed from your machine.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Auth (generate with: openssl rand -base64 32) ──
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI (Groq Cloud — console.groq.com) ──
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
